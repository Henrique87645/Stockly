<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stockly.Views.RegistroPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <!-- Grid para centralizar na tela -->
    <Grid>
        <ScrollView VerticalOptions="Center">

            <!-- Cartão Branco de Cadastro -->
            <Frame HorizontalOptions="Center" 
               VerticalOptions="Center" 
               WidthRequest="450" 
               BackgroundColor="White" 
               BorderColor="LightGray" 
               CornerRadius="12" 
               HasShadow="True"
               Padding="40">

                <VerticalStackLayout Spacing="15">

                    <!-- Cabeçalho -->
                    <Label Text="Nova Conta" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       TextColor="DarkBlue" 
                       HorizontalOptions="Center"/>

                    <Label Text="Preencha os dados abaixo para fazer parte do Stockly" 
                       FontSize="14" 
                       TextColor="Gray" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,15"/>

                    <!-- Formulário com Campos Estilizados -->

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome Completo:" FontAttributes="Bold" TextColor="#0E2356"/>
                        <!-- Envolvendo o Entry em um Frame para criar a "Caixa" do input -->
                        <Frame BorderColor="#E0E0E0" BackgroundColor="#F8F9FA" CornerRadius="8" Padding="15,0" HasShadow="False" HeightRequest="45">
                            <Entry TextColor="Black" BackgroundColor="Transparent" Placeholder="Ex: João da Silva" Text="{Binding Nome}"/>
                        </Frame>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="CPF:" FontAttributes="Bold" TextColor="#0E2356"/>
                            <Frame BorderColor="#E0E0E0" BackgroundColor="#F8F9FA" CornerRadius="8" Padding="15,0" HasShadow="False" HeightRequest="45">
                                <Entry TextColor="Black" BackgroundColor="Transparent" Keyboard="Numeric" Placeholder="Apenas números" Text="{Binding CPF}"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Tipo de Acesso:" FontAttributes="Bold" TextColor="#0E2356"/>
                            <Frame BorderColor="#E0E0E0" BackgroundColor="#F8F9FA" CornerRadius="8" Padding="5,0" HasShadow="False" HeightRequest="45">
                                <Picker TextColor="Black" BackgroundColor="Transparent" Title="Selecione..." SelectedItem="{Binding TipoSelecionado}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Administrador</x:String>
                                            <x:String>Cliente</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="E-mail:" FontAttributes="Bold" TextColor="#0E2356"/>
                        <Frame BorderColor="#E0E0E0" BackgroundColor="#F8F9FA" CornerRadius="8" Padding="15,0" HasShadow="False" HeightRequest="45">
                            <Entry TextColor="Black" BackgroundColor="Transparent" Keyboard="Email" Placeholder="exemplo@stockly.com" Text="{Binding Email}"/>
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Senha:" FontAttributes="Bold" TextColor="#0E2356"/>
                        <Frame BorderColor="#E0E0E0" BackgroundColor="#F8F9FA" CornerRadius="8" Padding="15,0" HasShadow="False" HeightRequest="45">
                            <Entry TextColor="Black" BackgroundColor="Transparent" IsPassword="True" Placeholder="Crie uma senha forte" Text="{Binding Senha}"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Botões de Ação -->
                    <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                        <Button Text="Confirmar Cadastro" 
                            FontAttributes="Bold" 
                            FontSize="16" 
                            TextColor="White" 
                            BackgroundColor="DarkBlue" 
                            CornerRadius="8" 
                            HeightRequest="50" 
                            Command="{Binding SalvarCadastroCommand}"/>

                        <!-- Botão de Voltar recém adicionado -->
                        <Button Text="Voltar para o Login" 
                            FontAttributes="Bold" 
                            FontSize="14" 
                            TextColor="Gray" 
                            BackgroundColor="Transparent" 
                            HorizontalOptions="Center"
                            Command="{Binding VoltarCommand}"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>

</ContentPage>