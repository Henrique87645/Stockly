<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stockly.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <!-- Grid principal para centralizar o conteúdo vertical e horizontalmente na tela -->
    <Grid>
        <ScrollView VerticalOptions="Center">

            <!-- Cartão Branco de Login -->
            <Frame HorizontalOptions="Center" 
               VerticalOptions="Center" 
               WidthRequest="400" 
               BackgroundColor="White" 
               BorderColor="LightGray" 
               CornerRadius="12" 
               Padding="40,50">

                <VerticalStackLayout Spacing="20">

                    <!-- Logo / Título -->
                    <Label Text="Stockly" 
                       FontSize="36" 
                       FontAttributes="Bold" 
                       TextColor="DarkBlue" 
                       HorizontalOptions="Center"/>

                    <Label Text="Acesse sua conta para continuar" 
                       FontSize="16" 
                       TextColor="Gray" 
                       HorizontalOptions="Center" 
                       Margin="0,-10,0,20"/>

                    <!-- Campo Email -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="E-mail:" FontAttributes="Bold" TextColor="#0E2356"/>
                        <Entry x:Name="txtEmail" 
                           Keyboard="Email" 
                           TextColor="Black" 
                           Placeholder="Ex: admin@stockly.com" 
                           ClearButtonVisibility="WhileEditing" 
                           Text="{Binding Email}"/>
                    </VerticalStackLayout>

                    <!-- Campo Senha -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Senha:" FontAttributes="Bold" TextColor="#0E2356"/>
                        <Entry x:Name="txtSenha" 
                           IsPassword="True" 
                           TextColor="Black" 
                           Placeholder="Digite sua senha" 
                           ClearButtonVisibility="WhileEditing" 
                           Text="{Binding Senha}"/>
                    </VerticalStackLayout>

                    <!-- Botão Entrar -->
                    <Button Text="Entrar" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        TextColor="White" 
                        BackgroundColor="DarkBlue" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        Margin="0,20,0,5" 
                        Command="{Binding EntrarCommand}"/>

                    <!-- Link para Registro -->
                    <Button Text="Ainda não tem conta? Registre-se" 
                        FontAttributes="Bold" 
                        FontSize="14" 
                        TextColor="DarkBlue" 
                        BackgroundColor="Transparent" 
                        HorizontalOptions="Center"
                        Command="{Binding RegistrarCommand}"/>

                </VerticalStackLayout>
            </Frame>
        </ScrollView>
    </Grid>

</ContentPage>
